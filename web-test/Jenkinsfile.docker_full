#!groovy
/**
 * 方案三：GitLab Webhook → Jenkins（JDK21 容器）打包 → Docker 构建镜像并部署
 *
 * 前置：
 *   - deploy/03-docker 已 compose up（Jenkins 挂载 docker.sock）
 *   - Job：Pipeline script from SCM，Script Path 指向本文件
 *     （本仓：deploy/03-docker/Jenkinsfile.example；独立 web-test 仓可拷到根并设 APP_SUBDIR=.）
 *   - GitLab Webhook → Jenkins Job
 *
 * 流程：
 *   checkout → mvn package（Maven Java8 容器）→ docker build → 冒烟 → 常驻部署
 */
pipeline {
  agent none
  options {
    timestamps()
    disableConcurrentBuilds()
  }
  parameters {
    string(name: 'APP_SUBDIR', defaultValue: 'web-test', description: '含 pom.xml / Dockerfile 的目录（独立仓填 .）')
    string(name: 'APP_IMAGE', defaultValue: 'web-test:ci', description: '构建出的应用镜像名')
    string(name: 'APP_RUN_CONTAINER', defaultValue: 'web-test', description: '常驻容器名')
    string(name: 'APP_HTTP_PORT', defaultValue: '8088', description: '宿主机映射端口')
  }
  environment {
    APP_SMOKE_CONTAINER = 'web-test-ci-smoke'
  }
  stages {
    stage('Prepare') {
      agent any
      steps {
        script {
          def sub = params.APP_SUBDIR?.trim() ?: 'web-test'
          if (sub == '.' || fileExists("${sub}/pom.xml")) {
            env.APP_DIR = (sub == '.') ? '.' : sub
          } else if (fileExists('pom.xml')) {
            env.APP_DIR = '.'
          } else {
            error "找不到 pom.xml（试过 APP_SUBDIR=${sub} 与仓库根）"
          }
          echo "APP_DIR=${env.APP_DIR}"
          sh 'java -version || true; docker version'
        }
      }
    }
    stage('Maven package (Docker agent)') {
      agent {
        docker {
          image 'maven:3.8.8-eclipse-temurin-8'
          args '-v $HOME/.m2:/root/.m2'
          reuseNode true
        }
      }
      steps {
        dir(env.APP_DIR) {
          sh 'mvn -B -DskipTests=false clean package'
        }
      }
      post {
        always {
          dir(env.APP_DIR) {
            junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
            archiveArtifacts artifacts: 'target/web-test-*.jar', fingerprint: true, allowEmptyArchive: true
          }
        }
      }
    }
    stage('Docker build app image') {
      agent any
      steps {
        dir(env.APP_DIR) {
          sh "docker build -t ${params.APP_IMAGE} ."
        }
      }
    }
    stage('Smoke run container') {
      agent any
      steps {
        sh """
          set -euo pipefail
          docker rm -f ${APP_SMOKE_CONTAINER} >/dev/null 2>&1 || true
          NETWORK="\${JENKINS_DOCKER_NETWORK:-ci-net}"
          docker run -d --name ${APP_SMOKE_CONTAINER} --network "\$NETWORK" ${params.APP_IMAGE}
          SMOKE_URL="http://${APP_SMOKE_CONTAINER}:8080/hello"
          echo "Smoke URL: \$SMOKE_URL (network=\$NETWORK)"
          for i in \$(seq 1 30); do
            if curl -fsS "\$SMOKE_URL" | grep -q hello; then
              echo smoke ok
              exit 0
            fi
            sleep 2
          done
          echo smoke failed >&2
          docker logs ${APP_SMOKE_CONTAINER} || true
          exit 1
        """
      }
      post {
        always {
          sh "docker rm -f ${APP_SMOKE_CONTAINER} >/dev/null 2>&1 || true"
        }
      }
    }
    stage('Docker deploy (run)') {
      agent any
      steps {
        sh """
          set -euo pipefail
          docker rm -f ${params.APP_RUN_CONTAINER} >/dev/null 2>&1 || true
          NETWORK="\${JENKINS_DOCKER_NETWORK:-ci-net}"
          docker run -d --name ${params.APP_RUN_CONTAINER} --restart unless-stopped \\
            --network "\$NETWORK" -p ${params.APP_HTTP_PORT}:8080 ${params.APP_IMAGE}
          echo "deployed: http://localhost:${params.APP_HTTP_PORT}/hello"
          docker ps --filter name=^/${params.APP_RUN_CONTAINER}\$ --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}'
        """
      }
    }
  }
}
