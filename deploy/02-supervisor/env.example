# cp env.example env.sh && edit
# 应用机环境（供 start-app.sh / 人工调试参考）
APP_DIR=/opt/web-test
APP_JAR=/opt/web-test/web-test.jar
APP_PORT=8088
JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
LOG_DIR=/opt/app-logs
PROGRAM_NAME=web-test
TZ=Asia/Shanghai

# Supervisor Web UI（install.sh）
ENABLE_SUPERVISOR_UI=1
SUPERVISOR_HTTP_BIND=0.0.0.0
SUPERVISOR_HTTP_PORT=9001
SUPERVISOR_HTTP_USER=admin
SUPERVISOR_HTTP_PASSWORD=admin
