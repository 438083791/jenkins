; 复制为 /etc/supervisor/conf.d/jenkins-agent.conf 并替换 SECRET / URL
[program:jenkins-agent]
command=java -jar /opt/ci/agent/agent.jar -url http://jenkins.example.com:8080 -secret REPLACE_SECRET -name agent-1 -workDir /opt/ci/agent/work
directory=/opt/ci/agent
user=jenkins
autostart=true
autorestart=true
startsecs=5
stdout_logfile=/opt/ci/logs/agent.out.log
stderr_logfile=/opt/ci/logs/agent.err.log
