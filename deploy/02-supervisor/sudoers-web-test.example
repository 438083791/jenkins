# 目标机：让「SSH 部署用户」免密操作 Supervisor 与安装 jar
# 首列必须是实际 SSH 登录名（默认 deploy）；install.sh 会自动替换
#   sudo visudo -cf /etc/sudoers.d/web-test-supervisor-deploy
#
# 若系统是 sudo-rs，路径可能是 /usr/bin/supervisorctl 等

deploy ALL=(root) NOPASSWD: /usr/bin/supervisorctl, /bin/supervisorctl, /usr/bin/chown, /bin/chown, /usr/bin/chmod, /bin/chmod, /usr/bin/sed, /bin/sed, /usr/bin/install, /bin/install, /usr/bin/mv, /bin/mv, /usr/bin/mkdir, /bin/mkdir
