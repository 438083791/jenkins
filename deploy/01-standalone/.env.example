# 复制为 .env 后修改（.env 已在 .gitignore，勿提交真实环境值）
#   cp .env.example .env
#
# install-*.sh / configure-firewall.sh 会自动加载同目录 .env；
# 未创建 .env 时使用脚本内置默认值。

# GitLab 服务器
GITLAB_HOST=gitlab.example.com
GITLAB_EXTERNAL_URL=http://gitlab.example.com

# Jenkins 服务器（install-jenkins.sh 会复用方案五 without-docker 脚本）
JENKINS_HOST=jenkins.example.com
JENKINS_HTTP_PORT=8080
JENKINS_HOME=/opt/ci/jenkins/home
JENKINS_WAR=/opt/ci/jenkins/jenkins.war
JENKINS_ADMIN_PASSWORD=admin

# 时区
TZ=Asia/Shanghai
