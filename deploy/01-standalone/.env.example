# 复制为 .env 后修改（.env 已在 .gitignore，勿提交真实环境值）
#   cp .env.example .env
#
# install-gitlab.sh / configure-firewall.sh 会自动加载同目录 .env；
# 未创建 .env 时使用脚本内置默认值。
#
# 安装 Jenkins 请使用 deploy/05-project-local/without-docker/（其目录下 .env），
# 勿再依赖本目录已删除的 install-jenkins.sh。

# GitLab 服务器
GITLAB_HOST=gitlab.example.com
GITLAB_EXTERNAL_URL=http://gitlab.example.com

# Jenkins 服务器（仅作文档/防火墙参考；安装走方案五 without-docker）
JENKINS_HOST=jenkins.example.com
JENKINS_HTTP_PORT=8080

# 时区
TZ=Asia/Shanghai
