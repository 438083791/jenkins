# 复制为 .env 后修改：cp .env.example .env
GITLAB_HTTP_PORT=80
GITLAB_SSH_PORT=2222
GITLAB_HOSTNAME=gitlab.local
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
TZ=Asia/Shanghai

# GitLab 镜像请钉死小版本
GITLAB_IMAGE=gitlab/gitlab-ce:17.11.0-ce.0

# Jenkins：由 ./jenkins/Dockerfile 构建（jenkins/jenkins:*-lts-jdk21 + docker CLI）
# 与方案五 with-docker / without-docker（JDK21）对齐
JENKINS_IMAGE_NAME=my-project-jenkins:scheme03

# Pipeline 部署的应用容器加入的网络（须与 compose networks.name 一致）
JENKINS_DOCKER_NETWORK=ci-net
COMPOSE_NETWORK_NAME=ci-net

# Linux 上 compose.sh up 会自动探测 docker.sock 的组 ID；也可手工填写
# DOCKER_GID=0
