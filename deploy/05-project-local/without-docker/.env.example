# 方案五 · 无 Docker：宿主机工具链
# 复制为 .env（推荐，与方案一 / Docker 方案一致）：
#   cp .env.example .env
#
# install-jenkins.sh 会自动加载同目录 .env

JENKINS_HOME=/opt/ci/jenkins/home
JENKINS_WAR=/opt/ci/jenkins/jenkins.war
JENKINS_HTTP_PORT=8080
JAVA_HOME_JENKINS=/usr/lib/jvm/java-21-openjdk-amd64
# 构建 web-test（Spring Boot 2.2 / Java 8）用的 JDK
JAVA_HOME_BUILD=/usr/lib/jvm/java-8-openjdk-amd64
MAVEN_HOME=/usr/share/maven
TZ=Asia/Shanghai
JENKINS_ADMIN_PASSWORD=admin
