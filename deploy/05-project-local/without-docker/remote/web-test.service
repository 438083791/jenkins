[Unit]
Description=web-test Spring Boot application
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/web-test
Environment=JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
Environment=APP_PORT=8080
ExecStart=/usr/lib/jvm/java-8-openjdk-amd64/bin/java -jar /opt/web-test/web-test.jar --server.port=${APP_PORT}
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
